{
  "name": "bun-ffi-extra",
  "version": "1.0.12",
  "description": "Extra features for Bun's FFI module.",
  "type": "module",
  "module": "src/index.ts",
  "main": "src/index.ts",
  "types": "dist/index.d.ts",
  "exports": {
    "types": "./src/index.ts",
    "bun": "./src/index.ts",
    "import": "./src/index.ts",
    "default": "./src/index.ts"
  },
  "license": "MIT",
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "keyword": [
    "bun",
    "ffi",
    "low-level",
    "c",
    "struct"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sully-vian/bun-ffi-extra.git"
  },
  "scripts": {
    "test": "bun test",
    "lint": "bunx biome check --write .",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun lint && bun test && bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@biomejs/biome": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
