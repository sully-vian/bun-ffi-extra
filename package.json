{
  "name": "bun-ffi-extra",
  "version": "1.0.14",
  "description": "Extra features for Bun's FFI module.",
  "type": "module",
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "types": "./dist/index.ts",
    "bun": "./dist/index.ts",
    "import": "./dist/index.ts",
    "default": "./dist/index.ts"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "keyword": [
    "bun",
    "ffi",
    "low-level",
    "c",
    "struct"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sully-vian/bun-ffi-extra.git"
  },
  "scripts": {
      "type-check":"tsc --noEmit",
    "test": "bun test",
    "lint": "bunx biome check --write .",
    "build:types": "tsc -p tsconfig.build.json",
    "build:js": "bun build ./src/index.ts --outdir ./dist --target bun",
    "build": "rm -rf dist && bun run build:js && bun run build:types",
    "prepublishOnly": "bun run type-check && bun run lint && bun run test && bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@biomejs/biome": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
